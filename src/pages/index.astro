---
import '../styles/custom.css';
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MamaSitas — База знаний по легализации в Испании</title>
    <meta name="description" content="Всё о документах, легализации и жизни в Испании без лишней воды" />
  </head>
  <body>
    <div class="main-hero">
      <img src="/avatar.jpg" alt="MamaSitas Logo" class="hero-avatar" style="width: 120px !important; height: 120px !important; max-width: 120px !important; max-height: 120px !important; min-width: 120px !important; min-height: 120px !important; border-radius: 50% !important; object-fit: cover !important; border: 2px solid #c7a153 !important; box-shadow: 0 0 25px rgba(199, 161, 83, 0.4) !important; display: block !important; margin: 0 auto 1.2rem auto !important;" />
      <h1 class="hero-title">M

      <div class="hero-links">
        <a href="/guides/ex-26-autonomo/" class="hero-card">
          <span class="hero-icon">💼</span>
          <span class="hero-text">Переход на Autónomo (EX-26)</span>
          <span class="hero-arrow">→</span>
        </a>
        <a href="/guides/ex-26-cuenta-ajena/" class="hero-card">
          <span class="hero-icon">📋</span>
          <span class="hero-text">Работа по контракту (Cuenta Ajena)</span>
          <span class="hero-arrow">→</span>
        </a>
        <a href="/guides/ex-25-menores/" class="hero-card">
          <span class="hero-icon">👶</span>
          <span class="hero-text">Резиденция для детей (EX-25)</span>
          <span class="hero-arrow">→</span>
        </a>
        <a href="/reference/tasas/" class="hero-card">
          <span class="hero-icon">🧮</span>
          <span class="hero-text">Как оплатить пошлины (Tasas)</span>
          <span class="hero-arrow">→</span>
        </a>
        <a href="https://t.me/mamasitas_es" target="_blank" class="hero-card hero-card-telegram">
          <span class="hero-text">Telegram-канал MamaSitas</span>
        </a>
      </div>
    </div>
  </body>
</html>
