---
import '../styles/custom.css';
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MamaSitas — База знаний по легализации в Испании</title>
    <meta name="description" content="Всё о документах, легализации и жизни в Испании без лишней воды" />
  </head>
  <body style="background-color: #1a0b10; margin: 0; font-family: system-ui, sans-serif; color: #ffffff;">
    <div class="main-hero" style="display: flex; flex-direction: column; align-items: center; max-width: 480px; margin: 0 auto; padding: 2.5rem 1rem; text-align: center;">
      
      <!-- Аватар-герб сверху, как вы хотели -->
      <img src="/avatar.jpg" alt="MamaSitas Logo" class="hero-avatar" style="width: 120px; height: 120px; border: 2px solid #c7a153; border-radius: 50%; object-fit: cover;" />
      <h1 class="hero-title" style="margin: 0 0 0.4rem; color: #ffffff; font-size: 2.2rem; font-weight: 800;">MamaSitas</h1>
      <p class="hero-subtitle" style="margin-bottom: 2rem; color: #d1c4c6; font-size: 0.95rem;">База знаний по легализации в Испании</p>

      <div class="hero-links" style="display: flex; flex-direction: column; gap: 0.85rem; width: 100%;">
        <a href="/guides/ex-26-autonomo/" class="hero-card">
          <span class="hero-icon">💼</span>
          <span class="hero-text">Переход на Autónomo (EX-26)</span>
          <span class="hero-arrow">→</span>
        </a>
        <a href="/guides/ex-26-cuenta-ajena/" class="hero-card">
          <span class="hero-icon">📋</span>
          <span class="hero-text">Работа по контракту (Cuenta Ajena)</span>
          <span class="hero-arrow">→</span>
        </a>
        <a href="/guides/ex-25-menores/" class="hero-card">
          <span class="hero-icon">👶</span>
          <span class="hero-text">Резиденция для детей (EX-25)</span>
          <span class="hero-arrow">→</span>
        </a>
        <a href="/reference/tasas/" class="hero-card">
          <span class="hero-icon">🧮</span>
          <span class="hero-text">Как оплатить пошлины (Tasas)</span>
          <span class="hero-arrow">→</span>
        </a>
        <a href="https://t.me/mamasitas_es" target="_blank" class="hero-card hero-card-telegram">
          <span class="hero-text">Telegram-канал MamaSitas</span>
        </a>
      </div>
    </div>
  </body>
</html>
